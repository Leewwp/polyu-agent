# PolyU-agent 生产环境变量模板
#
# 用法：不要直接改本文件——复制为 polyu-prod.env（600 权限）填入真实值，
# scp 到服务器 /opt/polyu/polyu-prod.env。真实文件不入仓（.gitignore 已挡）。
# 占位值全部为示例，无真实密钥。

# ---- 镜像 tag（deploy CI 每次部署 sed 更新；ghcr.io 全小写）----
# 映射：IMAGE_BACKEND→polyu-app 服务，IMAGE_FRONTEND→polyu-nginx 服务，IMAGE_ES→polyu-es 服务
IMAGE_BACKEND=ghcr.io/<github用户名小写>/polyu-agent-backend:latest
IMAGE_FRONTEND=ghcr.io/<github用户名小写>/polyu-agent-frontend:latest
IMAGE_ES=ghcr.io/<github用户名小写>/polyu-agent-es-ik:latest

# ---- PostgreSQL（自行随机生成强口令）----
POSTGRES_USER=polyu
POSTGRES_PASSWORD=CHANGE_ME_RANDOM

# ---- Redis（随机生成）----
REDIS_PASSWORD=CHANGE_ME_RANDOM

# ---- MinIO root（随机生成；同时是应用 rag.storage.s3 访问凭据）----
MINIO_ROOT_USER=polyu-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM

# ---- 资产桶完整公开前缀（含桶名；网关只反代 /minio/ragent-assets/ 前缀，O3/L6 收敛）----
ASSETS_PUBLIC_URL=https://<域名>/minio/ragent-assets

# ---- 模型 API keys ----
SILICONFLOW_API_KEY=
BAILIAN_API_KEY=
AIHUBMIX_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimaxi.com
MINERU_API_KEY=

# ---- admin 初始口令（空=AdminUserBootstrap 随机生成并日志打印一次；建议注入强口令）----
RAGENT_BOOTSTRAP_ADMIN_PASSWORD=

# ---- 邮件与开放注册（默认 logger 模式+注册关；启用开放注册须先配好 SMTP 凭据）----
# MAIL_FROM 建议为独立别名且与认证账号匹配；MAIL_MODE 与 REGISTRATION 两开关随 SMTP 就绪同批切换
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
RAGENT_MAIL_MODE=logger
RAGENT_REGISTRATION_ENABLED=false

# ---- 资源参数（保守默认，压测后可调；容器限额在 compose 内）----
APP_JAVA_OPTS=-Xms1g -Xmx2g -XX:+ExitOnOutOfMemoryError
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ---- 宿主端口（生产默认标准端口仅绑 127.0.0.1；本机冒烟时全套错峰覆盖）----
# HOST_PORT_APP=9090
# HOST_PORT_PG=5432
# HOST_PORT_REDIS=6379
# HOST_PORT_MINIO=9000
# HOST_PORT_MINIO_CONSOLE=9001
# HOST_PORT_ES=9200
# HOST_PORT_HTTP=80
# HOST_PORT_HTTPS=443

# ---- TLS（默认 ./certs ./certbot-www 相对 /opt/polyu）----
# CERTS_DIR=./certs
# CERTBOT_WWW=./certbot-www

# ---- RocketMQ broker 存储（bind mount；server-init.sh 已预建 /opt/polyu/rmq-store 并 chown 3000）----
# RMQ_STORE_DIR=./rmq-store
